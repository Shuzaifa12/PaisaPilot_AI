# PaisaPilot AI — Backend Environment Configuration Template
# Copy this file to .env in the backend/ directory or set environment variables in your shell.

# Optional Backend Settings
# Priority 1: OpenRouter (recommended for free NVIDIA Nemotron access)
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Priority 2: Direct NVIDIA NIM API
# NEMOTRON_API_KEY=nvapi-...
NEMOTRON_API_BASE=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-4-34b-instruct

# Note: All API keys are optional. When omitted or unset,
# the backend runs in deterministic fallback mode with zero API keys required.
